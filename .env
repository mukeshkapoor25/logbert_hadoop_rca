# =============================================================================
# LogBERT Hadoop RCA - Environment Configuration
# =============================================================================
# This file contains environment variables for the LogBERT Hadoop Root Cause
# Analysis system. Copy this file to .env and modify values as needed.
# =============================================================================

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================
PROJECT_NAME=LogBERT-Hadoop-RCA
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Pre-trained LogBERT model paths
MODEL_PATH=AI_MODELS/trained_models/Hadoop_logbert/bert/best_bert.pth
VOCAB_PATH=AI_MODELS/trained_models/Hadoop_logbert/vocab.pkl
CENTER_PATH=AI_MODELS/trained_models/Hadoop_logbert/bert/best_center.pt
PARAMS_PATH=AI_MODELS/trained_models/Hadoop_logbert/bert/parameters.txt

# Model hyperparameters
HIDDEN_SIZE=512
NUM_LAYERS=6
ATTENTION_HEADS=8
MAX_SEQUENCE_LENGTH=256
MASK_RATIO=0.7
ANOMALY_THRESHOLD=2.0

# =============================================================================
# DATASET CONFIGURATION
# =============================================================================
# Hadoop dataset paths
DATASET_ROOT=AI_MODELS/datasets/Hadoop
TRAIN_DATA_PATH=AI_MODELS/trained_models/Hadoop_logbert/train
ABNORMAL_LABELS_PATH=AI_MODELS/datasets/Hadoop/abnormal_label.txt
LOG_TEMPLATES_PATH=AI_MODELS/trained_models/Hadoop_logbert/rca_abnormal_hadoop.log_templates.csv

# Data processing parameters
MIN_SEQUENCE_LENGTH=5
WINDOW_SIZE=64
ADAPTIVE_WINDOW=true
TRAIN_RATIO=1.0
VALID_RATIO=0.25
TEST_RATIO=1.0

# =============================================================================
# API CONFIGURATION
# =============================================================================
# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# CORS settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET", "POST"]
CORS_HEADERS=["*"]

# Upload limits
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=["log", "txt"]

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================
# GPU/CPU settings
USE_CUDA=true
CUDA_DEVICES=0
NUM_WORKERS=4
PIN_MEMORY=true

# Memory management
BATCH_SIZE=32
MAX_MEMORY_USAGE=8GB
CACHE_SIZE=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Application logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/application.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Model training logs
TRAINING_LOG_DIR=logs/training
TENSORBOARD_LOG_DIR=logs/tensorboard
MODEL_CHECKPOINT_DIR=checkpoints

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Hugging Face model for explanations
HF_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
HF_CACHE_DIR=/tmp/hf_cache
HF_USE_AUTH_TOKEN=false

# Model serving
MODEL_SERVING_TIMEOUT=30
MAX_EXPLANATION_TOKENS=200
TOP_EVENTS_TO_ANALYZE=5

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# API Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File upload security
TEMP_UPLOAD_DIR=temp_uploads
CLEANUP_INTERVAL_HOURS=24

# =============================================================================
# DATABASE CONFIGURATION (Optional - for future enhancements)
# =============================================================================
# Database settings (if you want to add persistence)
# DATABASE_URL=sqlite:///./logbert_rca.db
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Metrics and monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_ENDPOINT=/health

# Performance monitoring
ENABLE_PROFILING=false
PROFILE_OUTPUT_DIR=profiles

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker-specific settings
DOCKER_USER=logbert
DOCKER_WORKDIR=/app
DOCKER_EXPOSE_PORT=8000

# Volume mounts
DOCKER_DATA_VOLUME=/app/data
DOCKER_MODELS_VOLUME=/app/models
DOCKER_LOGS_VOLUME=/app/logs

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Development tools
AUTO_RELOAD=true
ENABLE_DEBUG_TOOLBAR=true
SHOW_SQL_QUERIES=false

# Testing
TEST_DATABASE_URL=sqlite:///./test_logbert_rca.db
TEST_LOG_LEVEL=DEBUG
PYTEST_WORKERS=auto

# Code quality
ENABLE_LINTING=true
ENABLE_TYPE_CHECKING=true
COVERAGE_MIN_PERCENTAGE=80

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Production-specific settings (uncomment for production)
# DEBUG=false
# LOG_LEVEL=WARNING
# API_RELOAD=false
# API_WORKERS=4
# USE_CUDA=true
# BATCH_SIZE=64
# ENABLE_METRICS=true
# CLEANUP_INTERVAL_HOURS=6
